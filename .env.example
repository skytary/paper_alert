# Copy this file to .env and fill in your keys. Never share or commit .env.

# Anthropic API key (https://platform.claude.com -> API keys)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Zotero API key with library and write access (https://www.zotero.org/settings/keys)
# Leave the Zotero lines as they are if you do not use Zotero.
ZOTERO_API_KEY=your_zotero_api_key_here

# Your Zotero user ID ("Your user ID for use in API calls" on the same page)
ZOTERO_USER_ID=123456

# Library type: user (your own library) or group
ZOTERO_LIBRARY_TYPE=user
