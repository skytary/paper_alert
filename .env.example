# Anthropic API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Zotero API 키 (https://www.zotero.org/settings/keys)
ZOTERO_API_KEY=your_zotero_api_key_here

# Zotero 사용자 ID (https://www.zotero.org/settings/keys 에서 확인)
ZOTERO_USER_ID=123456

# 라이브러리 타입: user 또는 group
ZOTERO_LIBRARY_TYPE=user
